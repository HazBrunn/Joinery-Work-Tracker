rules_version = '2';

// Firestore security rules for Joinery Jobs Tracker.
//
// The app uses Google Sign-In, so every request carries a real auth token
// belonging to the signed-in Google account. These rules lock all read/write
// to the owner's account ONLY — no other signed-in Google account can touch
// the data, even if they somehow reach the app.
//
// OWNER_UID is the owner's Firebase Auth UID (shown in Settings → Account).
// To transfer ownership or add a device under a different account, update it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /app_state/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == "Zzrd3zL0gNQI1DsT263Dw8qfFKg1";
    }
  }
}
