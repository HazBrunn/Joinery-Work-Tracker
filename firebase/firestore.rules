rules_version = '2';

// Firestore security rules for Joinery Jobs Tracker.
//
// The app uses Google Sign-In, so every request carries a real auth token
// belonging to the signed-in Google account. These rules allow read/write
// only to authenticated requests.
//
// To lock down to ONLY your account (recommended), replace the rule below with:
//   allow read, write: if request.auth.uid == "YOUR_UID_HERE";
// Your UID is displayed in Settings → Account after you first sign in.
service cloud.firestore {
  match /databases/{database}/documents {
    match /app_state/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
