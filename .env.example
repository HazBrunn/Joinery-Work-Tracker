# Joinery Jobs Tracker — environment
#
# The app runs LOCAL-FIRST by default (data stored in your browser via localStorage),
# so it works with no setup at all. When you're ready for cloud sync + photo storage,
# connect Firebase by filling these in, then restart the dev server.
#
# Copy this file to ".env" and add your values.

# Leave VITE_DATA_BACKEND as "local" to use browser storage, or "firebase" for the cloud.
VITE_DATA_BACKEND=local

# Firebase web app config — from the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration → Config.
# These are public client values; access is controlled by Firestore/Storage rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
