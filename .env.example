# Joinery Jobs Tracker — environment
#
# The app runs LOCAL-FIRST by default (data stored in your browser via localStorage),
# so it works with no setup at all. Point it at Supabase for cloud sync, photo
# storage and sign-in, then restart the dev server.
#
# Copy this file to ".env" and add your values.

# "local" for browser storage, or "supabase" for the cloud.
VITE_DATA_BACKEND=local

# The same Supabase project as the life tracker — joinery lives in its own
# schema beside public and fitness.
#   Supabase dashboard → Project Settings → API → Project URL / anon public key.
# These are public client values; access is controlled by row-level security,
# not by keeping them secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
